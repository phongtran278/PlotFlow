{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "plotflow-state-api-staging",
  "main": "src/index.js",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "observability": {
    "enabled": true
  },
  "vars": {
    "ACCESS_TEAM_DOMAIN": "https://white-flower-20f9.cloudflareaccess.com",
    "ACCESS_AUD": "1e3023284947bf1806b517acf87c4e3020e67e2b23b6672c55c6e3e924272823",
    "AZURE_STATE_CONTAINER_NAME": "plotflow-state-private"
  },
  "keep_vars": true,
  "previews": {
    "vars": {
      "PLOTFLOW_PREVIEW_DISABLE_STATE_ACCESS": "1"
    }
  }
}
